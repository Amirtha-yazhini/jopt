# JOpt Environment Configuration
# Copy this file to .env or set environment variables in your shell.

# ==============================================================================
# Backend Configuration (Java Playground Server)
# ==============================================================================

# Port for the JOpt playground HTTP server (default: 7070)
# Required: No (defaults to 7070)
PORT=7070

# Alternative environment variable for the backend port (takes effect if PORT is unset)
# Required: No
JOPT_PORT=7070

# Path to JDK 21 installation directory.
# Gradle and the playground require a full JDK (not JRE) with JavaCompiler support.
# Required: Only if JDK 21 is not the default `java` on your PATH.
# Example (macOS Homebrew / SDKMAN):
# JAVA_HOME=/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home
# Example (Linux):
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
# Example (Windows):
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.12.1-hotspot

# ==============================================================================
# Frontend Configuration (Vite Dev Server)
# ==============================================================================

# Target URL for the Vite development server proxy (/api -> backend)
# Required: No (defaults to http://localhost:7070)
JOPT_BACKEND=http://localhost:7070

# Port for the Vite development server (web/)
# Required: No (defaults to 5173)
VITE_PORT=5173
